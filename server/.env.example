# =====================================================================
#  AURA PRO SETTINGS: paste your keys after the = sign. No quotes, no spaces.
#  Step-by-step help for every key is in KEYS-GUIDE.md
# =====================================================================

# ---- 1. REQUIRED ----
MONGODB_URI=mongodb://127.0.0.1:27017/aura_pro
JWT_SECRET=change-me
# Session length in minutes (expires after this much inactivity)
SESSION_MINUTES=3
GEMINI_API_KEY=

# ---- 2. GOOGLE LOGIN (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 3. FACEBOOK + INSTAGRAM (one Meta app does both) ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set to true if Meta shows "Invalid Scopes" (login only, no Page/Instagram permissions)
FACEBOOK_LOGIN_ONLY=false

# ---- 4. INSTAGRAM IMAGE HOSTING: free Cloudinary account ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Leave these as they are while running on your computer ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
GEMINI_MODEL=gemini-2.5-flash
GRAPH_VERSION=v23.0
# Only when hosted online: your https site address (alternative to Cloudinary)
PUBLIC_BASE_URL=

# ---- 3b. INSTAGRAM LOGIN (the "Continue with Instagram" button) ----
# Meta App Dashboard > Instagram > API setup with Instagram login > Business login settings
# These are the *Instagram* App ID / secret (different from the Facebook ones above).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: only if Meta refuses http://localhost as a redirect (see KEYS-GUIDE.md section 4b)
INSTAGRAM_REDIRECT_URI=

# ---- Facebook login permissions override ----
# "Invalid Scopes" from Meta? Keep this as public_profile so login works right now.
# After you add the permissions in your Meta app (see KEYS-GUIDE.md), delete this line to get Pages + Instagram connect at login.
FACEBOOK_SCOPES=

